// CUIDA — Modelo de datos, fase 1
//
// Hereda el patrón de IDENTIA: identidad permanente, roles, estados, auditoría,
// multi-tenant por organización desde el principio.
// Añade la capa que faltaba en IDENTIA: necesidad → solicitud → servicio →
// asignación → visita → actuación → seguimiento → cierre.
//
// Regla del masterplan (sección 5): PERSONA ≠ SOLICITUD ≠ SERVICIO ≠ VISITA.
// Una persona puede tener muchas solicitudes y servicios; una modificación
// administrativa nunca debe destruir el historial (por eso el AuditLog y el
// EstadoHistorial son de solo-inserción).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidad, tenancy y roles (heredado de IDENTIA)
// ---------------------------------------------------------------------------

enum EstadoOrganizacion {
  PRUEBA
  ACTIVA
  SUSPENDIDA
  CERRADA
}

model Organizacion {
  id                 String             @id @default(cuid())
  codigo             String             @unique // ORG-00017
  nombre             String
  estado             EstadoOrganizacion @default(PRUEBA)
  // Modelo de negocio (sección "función es cobrar por gestión un pequeño
  // porcentaje"): comisión que se retiene de la tarifa cobrada a la familia
  // antes de liquidar al profesional/empresa colaboradora.
  comisionPorcentaje Decimal            @default(15) @db.Decimal(5, 2)

  // Quién emite las facturas. Sin esto la factura era un número en pantalla
  // sin identidad: no se puede entregar a nadie.
  razonSocial           String?
  cif                   String?
  direccionFiscal       String?
  codigoPostal          String?
  municipio             String?
  provincia             String?
  telefono              String?
  emailFacturacion      String?
  // Serie de facturación y contador. La numeración debe ser correlativa y sin
  // huecos dentro de cada serie y ejercicio.
  serieFactura          String  @default("A")
  // Acreedor SEPA: el IBAN donde entra el dinero y el identificador que el
  // banco asigna a la empresa para poder girar recibos.
  ibanCobro             String?
  identificadorAcreedor String?
  // El BIC ya no hace falta para SEPA dentro de la zona euro, pero algunos
  // bancos lo siguen pidiendo en el fichero.
  bicCobro              String?

  // Forma jurídica y datos registrales. Una S.L. tiene que hacer constar en
  // sus facturas y en su web los datos del Registro Mercantil (art. 24 de la
  // Ley de Sociedades de Capital), y sin ellos la factura está incompleta.
  formaJuridica     String?
  registroMercantil String? // "Registro Mercantil de Cantabria"
  registroTomo      String?
  registroFolio     String?
  registroHoja      String?
  // Actividad económica: el CNAE clasifica la empresa y el epígrafe de IAE es
  // el alta censal con la que se factura.
  cnae              String?
  epigrafeIae       String?
  web               String?

  // Seguro de responsabilidad civil. En ayuda a domicilio no es un extra: casi
  // todas las comunidades lo exigen para poder prestar el servicio, y la
  // póliza caduca.
  seguroAseguradora String?
  seguroPoliza      String?
  seguroCobertura   Decimal?  @db.Decimal(12, 2)
  seguroVencimiento DateTime?

  // Autorización administrativa como entidad de servicios sociales. En
  // Cantabria, el Registro de Entidades, Centros y Servicios Sociales; en cada
  // comunidad cambia el nombre pero no la obligación.
  registroEntidadesNumero String?
  registroEntidadesOrgano String?

  // Lo que se aplica por defecto al facturar, para no tenerlo que decidir cada
  // vez: el IVA cuando la necesidad no trae el suyo, y los días que se da de
  // plazo para pagar.
  ivaPorDefecto   Decimal @default(10) @db.Decimal(5, 2)
  diasVencimiento Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios              Usuario[]
  personas              Persona[]
  profesionales         Profesional[]
  empresasColaboradoras EmpresaColaboradora[]
  solicitudes           Solicitud[]
  servicios             Servicio[]
  facturas              Factura[]
  remesas               Remesa[]
  liquidaciones         Liquidacion[]
  auditLogs             AuditLog[]
  reglasNegocio         ReglasNegocio?
  tarifas               Tarifa[]
  archivos              Archivo[]
  politicaConservacion  PoliticaConservacion?

  registrosFacturacion RegistroFacturacion[]

  @@map("organizaciones")
}

enum RolUsuario {
  PERSONA
  FAMILIAR
  PROFESIONAL
  COORDINADOR
  ORGANIZACION
  ADMIN
  SUPERADMIN
}

// El acceso a información personal debe estar justificado y limitado a lo
// necesario (AEPD). El rol determina la intención de acceso; los permisos
// finos (qué persona concreta) los otorgan FamiliarRelacion y la pertenencia
// a organización.
model Usuario {
  id           String     @id @default(cuid())
  // Nombre para mostrar (sección "unificar... en un único perfil"): permite
  // identificar a un familiar o cuidador por su nombre en vez de solo por
  // email en listados, chat y actividad. Opcional: el email sigue siendo el
  // identificador de acceso.
  nombre       String?
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  // Qué hace dentro de la empresa. El rol dice qué puede tocar en la
  // aplicación; el puesto, a qué se dedica — coordinación, administración,
  // calidad… No todo el personal interno coordina servicios.
  puesto       String?
  telefono     String?
  fechaAlta    DateTime?
  fechaBaja    DateTime?
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  organizacionId String?
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])

  // Un usuario PERSONA está enlazado 1:1 a su ficha de Persona.
  personaId String?  @unique
  persona   Persona? @relation("PersonaUsuario", fields: [personaId], references: [id])

  // Un usuario PROFESIONAL está enlazado 1:1 a su ficha de Profesional.
  profesionalId String?      @unique
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])

  familiarDe               FamiliarRelacion[]  @relation("UsuarioFamiliar")
  solicitudesCreadas       Solicitud[]         @relation("SolicitudCreadaPor")
  incidenciasAsignadas     Incidencia[]        @relation("IncidenciaResponsable")
  incidenciasCreadas       Incidencia[]        @relation("IncidenciaCreadaPor")
  notificaciones           Notificacion[]
  mensajes                 Mensaje[]
  auditLogs                AuditLog[]
  correccionesFichaje      CorreccionFichaje[]
  archivosSubidos          Archivo[]           @relation("ArchivoSubidoPor")
  visitasCerradas          Visita[]            @relation("VisitaCerradaPor")
  ajustesDecididos         Visita[]            @relation("VisitaAjusteDecididoPor")
  consentimientosRecogidos Consentimiento[]    @relation("ConsentimientoRecogidoPor")
  consentimientosRevocados Consentimiento[]    @relation("ConsentimientoRevocadoPor")

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Personas, familiares y profesionales
// ---------------------------------------------------------------------------

enum EstadoPersona {
  PENDIENTE
  ACTIVA
  SUSPENDIDA
  ARCHIVADA
}

model Persona {
  id              String        @id @default(cuid())
  codigo          String        @unique // CUI-000184 (identificador permanente)
  nombre          String
  apellidos       String
  fechaNacimiento DateTime?
  telefono        String?
  direccion       String?
  preferencias    String?
  // Perfil completo (sección "Usuarios" del coordinador): información
  // operativa que necesita quien presta el servicio, nunca una historia
  // clínica (sección 14 — ayuda cotidiana ≠ diagnóstico sanitario).
  contactos       String? // contactos de emergencia, en texto libre
  medicacion      String?
  medico          String? // médico/centro de referencia
  recomendaciones String?
  estado          EstadoPersona @default(PENDIENTE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  usuario          Usuario?           @relation("PersonaUsuario")
  familiares       FamiliarRelacion[]
  solicitudes      Solicitud[]
  documentos       Documento[]
  facturas         Factura[]
  mensajes         Mensaje[]
  datosFacturacion DatosFacturacion?
  consentimientos  Consentimiento[]

  @@map("personas")
}

// A quién se le factura y cómo se le cobra. Va aparte de Persona a propósito:
// quien recibe el cuidado y quien paga rara vez son la misma persona — la
// factura suele ir a nombre de la hija, con su NIF y su cuenta. Meterlo en
// Persona habría obligado a falsear los datos de la persona atendida.
model DatosFacturacion {
  id        String  @id @default(cuid())
  personaId String  @unique
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  // Titular de la factura: nombre o razón social, y su NIF/CIF.
  titular         String
  nif             String?
  direccionFiscal String?
  codigoPostal    String?
  municipio       String?
  provincia       String?
  email           String? // a dónde se envía la factura

  formaPago       FormaPago @default(DOMICILIACION)
  // Día del mes en que se gira el recibo. Las empresas del sector suelen
  // cobrar todas el mismo día para poder mandar una sola remesa.
  diaCobro        Int       @default(5)
  // Días desde la emisión hasta el vencimiento cuando no se domicilia.
  diasVencimiento Int       @default(30)

  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mandatos MandatoSepa[]

  @@map("datos_facturacion")
}

// Autorización firmada por el cliente para que la empresa gire recibos a su
// cuenta. Sin mandato en vigor no se puede domiciliar: la remesa lo exige.
model MandatoSepa {
  id                 String           @id @default(cuid())
  // Referencia única del mandato que viaja en el fichero SEPA.
  referencia         String           @unique // MND-000012
  datosFacturacionId String
  datosFacturacion   DatosFacturacion @relation(fields: [datosFacturacionId], references: [id], onDelete: Cascade)

  titular          String
  iban             String
  bic              String?
  fechaFirma       DateTime
  estado           EstadoMandato @default(ACTIVO)
  // Un mandato es "primero" hasta que se cobra la primera vez; después es
  // recurrente. El banco lo necesita para tratar el adeudo.
  primerCobroHecho Boolean       @default(false)
  revocadoAt       DateTime?
  createdAt        DateTime      @default(now())

  facturas Factura[]

  @@map("mandatos_sepa")
}

// Relación autorizada de un familiar/representante sobre una persona atendida.
// El acceso del familiar se limita a los permisos concedidos aquí, nunca al
// rol por sí solo (principio de minimización, AEPD).
model FamiliarRelacion {
  id                String    @id @default(cuid())
  personaId         String
  persona           Persona   @relation(fields: [personaId], references: [id])
  usuarioId         String
  usuario           Usuario   @relation("UsuarioFamiliar", fields: [usuarioId], references: [id])
  parentesco        String // "Hija", "Hijo", "Cónyuge"...
  esRepresentante   Boolean   @default(false)
  puedeSolicitar    Boolean   @default(true)
  puedeVerHistorial Boolean   @default(true)
  // Ver importes/tarifas es un permiso propio, distinto de ver el historial:
  // una persona atendida (rol PERSONA) nunca ve tarifas; un familiar
  // autorizado las ve solo si se le concede explícitamente este permiso.
  puedeVerImportes  Boolean   @default(true)
  createdAt         DateTime  @default(now())
  revocadoAt        DateTime?

  @@unique([personaId, usuarioId])
  @@map("familiar_relaciones")
}

enum CarneConducir {
  NO
  B // turismo, el habitual
  A // moto
  C // camión
  D // autobús
}

// Titulación de referencia en atención a domicilio, de menos a más.
enum Titulacion {
  SIN_TITULACION
  ATENCION_SOCIOSANITARIA // certificado de profesionalidad
  AUXILIAR_ENFERMERIA // TCAE
  ENFERMERIA
  TRABAJO_SOCIAL
  FISIOTERAPIA
  TERAPIA_OCUPACIONAL
  PSICOLOGIA
  OTRA
}

enum EstadoProfesional {
  PENDIENTE
  VERIFICADO
  ACTIVO
  SUSPENDIDO
  INACTIVO
}

model Profesional {
  id             String                  @id @default(cuid())
  codigo         String                  @unique // PRO-00031
  nombre         String
  apellidos      String
  telefono       String?
  // Zona de trabajo. Era texto libre y cada quien escribía una cosa
  // ("Centro", "centro", "Santander centro"), así que no se podía filtrar ni
  // agrupar. Ahora son dos códigos de una lista cerrada.
  comunidad      String?
  municipio      String?
  // Se conserva el texto anterior para no perder lo que ya había escrito y
  // para poder afinar ("barrio de la Inmobiliaria", "zona rural").
  zona           String?
  // Cómo trabaja. De aquí sale todo lo económico: a un autónomo se le retiene
  // IRPF y él emite su factura; a un empleado se le resume la jornada para la
  // nómina, que hace la gestoría fuera de aquí.
  tipoRelacion   TipoRelacionProfesional @default(AUTONOMO)
  irpfPorcentaje Decimal?                @db.Decimal(5, 2)
  // Datos de contrato. Con relación mercantil (autónoma) no hay alta ni baja
  // laboral, pero sí fecha desde la que colabora.
  tipoContrato   TipoContrato?
  fechaAlta      DateTime?
  fechaBaja      DateTime?
  categoria      String?
  // Horas semanales de contrato, sólo para los laborales: sirve para ver si
  // se están cubriendo o se están pasando.
  horasSemanales Int?

  // Lo que hace falta saber para mandarle según qué servicio: si puede
  // conducir, si tiene coche y qué ha estudiado.
  carneConducir  CarneConducir     @default(NO)
  vehiculoPropio Boolean           @default(false)
  titulacion     Titulacion?
  // Datos personales y de cobro (sección "los perfiles de profesionales se
  // deben poder editar e incluir información número de cuenta, Bizum, carné,
  // datos personales..."). Información sensible: solo la ve el propio
  // profesional y los gestores de la organización, nunca la persona atendida.
  dni            String?
  numeroCuenta   String?
  bizum          String?
  // Perfil profundo (sección "el perfil de Carmen debe ser más profundo...
  // biografía, tipo CV, para que los familiares también acepten y vean las
  // cualidades de Carmen"): visible para coordinación y para la familia al
  // valorar quién atiende a la persona, nunca solo un nombre en una lista.
  foto           String?
  biografia      String?
  // Disponibilidad semanal (sección "incluir disponibilidad"): JSON con días
  // de la semana y franja horaria — texto libre en BD, estructurado solo en
  // el frontend, para no tener que migrar otra vez si cambia la forma.
  disponibilidad String?
  estado         EstadoProfesional @default(PENDIENTE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  // Si trabaja para una empresa colaboradora (no independiente), se
  // autorrellena al asignarla a un servicio (sección coordinación).
  empresaColaboradoraId String?
  empresaColaboradora   EmpresaColaboradora? @relation(fields: [empresaColaboradoraId], references: [id])

  usuario          Usuario?
  servicios        Servicio[]
  mensajes         Mensaje[]
  interesEn        ServicioInteres[]
  documentos       Documento[]
  visitas          Visita[]
  liquidaciones    Liquidacion[]
  ausencias        Ausencia[]
  registrosJornada RegistroJornada[]

  @@map("profesionales")
}

enum EstadoEmpresaColaboradora {
  ACTIVA
  INACTIVA
}

// Empresa externa a la que la organización puede subcontratar un servicio,
// en vez de (o además de) asignarlo a un profesional interno.
model EmpresaColaboradora {
  id           String                    @id @default(cuid())
  codigo       String                    @unique // EXT-00001
  nombre       String
  contacto     String?
  // Datos administrativos/de cobro, editables desde coordinación (igual que
  // en el perfil de profesional independiente).
  cif          String?
  direccion    String?
  numeroCuenta String?
  estado       EstadoEmpresaColaboradora @default(ACTIVA)
  createdAt    DateTime                  @default(now())

  // Contrato de encargo del tratamiento (art. 28 RGPD). Cuando una empresa
  // colaboradora atiende a una persona, recibe su nombre, su dirección y lo
  // que hace falta para cuidarla: eso es una cesión de datos, y sin contrato
  // firmado la responsable es la organización y la infracción también. Por eso
  // no es un campo informativo: sin él no se le puede asignar un servicio.
  encargoFirmado   Boolean   @default(false)
  encargoFecha     DateTime?
  encargoArchivoId String?
  encargoArchivo   Archivo?  @relation("EncargoTratamiento", fields: [encargoArchivoId], references: [id])

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  servicios     Servicio[]
  profesionales Profesional[]

  @@map("empresas_colaboradoras")
}

// ---------------------------------------------------------------------------
// Catálogo de servicios (lenguaje humano → dato estructurado, y también lo
// que la organización factura). Antes había dos catálogos parecidos —
// "necesidades" (cómo lo pide la persona: compra, acompañamiento...) y un
// catálogo aparte solo para el IVA de facturación — que eran la misma idea
// contada dos veces (sección "unifiquemos: Servicios son lo que ofrecemos,
// Solicitudes son las que nos hacen los usuarios"). Ahora es uno solo: cada
// Servicio del catálogo ya lleva su % de IVA (4% superreducido para plazas
// concertadas/prestación vinculada a dependencia, 10% reducido para
// contratación particular), y una Solicitud simplemente elige uno.
model NecesidadCatalogo {
  id            String   @id @default(cuid())
  codigo        String   @unique // "compra", "acompanamiento", "compania"...
  nombre        String
  descripcion   String?
  ivaPorcentaje Decimal  @default(4) @db.Decimal(5, 2)
  precioBase    Decimal? @db.Decimal(10, 2)
  activo        Boolean  @default(true)

  solicitudes Solicitud[]
  tarifas     Tarifa[]

  @@map("necesidades_catalogo")
}

// ---------------------------------------------------------------------------
// Cadena funcional de CUIDA: necesidad → solicitud → servicio → visita →
// actuación → seguimiento → cierre
// ---------------------------------------------------------------------------

enum EstadoSolicitud {
  BORRADOR
  ENVIADA
  EN_REVISION
  BUSCANDO
  PROPUESTA
  ACEPTADA
  CANCELADA
  CERRADA
}

model Solicitud {
  id               String          @id @default(cuid())
  codigo           String          @unique // SOL-000582
  descripcionLibre String // texto tal cual lo pide la persona/familiar
  estado           EstadoSolicitud @default(BORRADOR)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id])

  necesidadId String
  necesidad   NecesidadCatalogo @relation(fields: [necesidadId], references: [id])

  creadaPorUsuarioId String
  creadaPor          Usuario @relation("SolicitudCreadaPor", fields: [creadaPorUsuarioId], references: [id])

  plan     Plan?
  servicio Servicio?

  estadoHistorial EstadoHistorial[]

  @@map("solicitudes")
}

model Plan {
  id              String    @id @default(cuid())
  solicitudId     String    @unique
  solicitud       Solicitud @relation(fields: [solicitudId], references: [id])
  fechaInicio     DateTime
  // Nula = indefinido / hasta nuevo aviso (sección "si necesita a alguien
  // para indefinido"): un servicio recurrente sin fecha de fin conocida
  // todavía, en vez de forzar una fecha ficticia.
  fechaFin        DateTime?
  recurrencia     String? // "diaria", "L-V", "puntual"...
  franjaHoraria   String? // "Mañana", "Tarde", "Todo el día"...
  horaInicio      String? // "09:00"
  horaFin         String? // "12:00"
  tareasPrevistas String? // lista libre inicial de tareas esperadas
  notas           String?
  createdAt       DateTime  @default(now())

  @@map("planes")
}

enum EstadoServicio {
  PENDIENTE
  ASIGNADO
  CONFIRMADO
  EN_CURSO
  FINALIZADO
  VALIDADO
  CERRADO
  CANCELADO
}

enum TipoTarifa {
  PAGADO
  VOLUNTARIO
}

enum EstadoPagoProfesional {
  PENDIENTE
  PAGADO
}

// Clasificación operativa del servicio (sección "hay que clasificar bien
// los servicios para poder cotizarlos y ubicarlos y gestionarlos
// correctamente"): un encargo puntual (ej. "limpieza el viernes") frente a
// un contrato recurrente (ej. "acompañamiento todos los días de 9 a 13").
enum TipoServicio {
  PUNTUAL
  RECURRENTE
}

model Servicio {
  id           String         @id @default(cuid())
  codigo       String         @unique // SRV-000721
  estado       EstadoServicio @default(PENDIENTE)
  tipoServicio TipoServicio   @default(PUNTUAL)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  solicitudId String    @unique
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])

  profesionalId String?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])

  // Subcontratación opcional a una empresa colaboradora, alternativa o
  // adicional a la asignación de un profesional interno.
  empresaColaboradoraId String?
  empresaColaboradora   EmpresaColaboradora? @relation(fields: [empresaColaboradoraId], references: [id])

  // Información económica: solo visible para gestores de la organización y
  // para el familiar autorizado con permiso explícito (sección 4/14 —
  // minimización). La persona atendida nunca la recibe.
  //
  // CUIDA cobra por tiempo, así que el precio se fija por hora y el importe
  // sale de las horas acordadas: 2 h a 13 €/h son 26 €. Antes tarifaImporte
  // era un total a ojo y no se podía comprobar contra lo fichado.
  precioHora         Decimal? @db.Decimal(10, 2)
  // Duración acordada de una jornada, en minutos. Sale del plan (de la hora
  // de inicio a la de fin) pero se congela aquí: es contra esto contra lo
  // que se compara lo fichado al verificar.
  minutosPrevistos   Int?
  // % de CUIDA para este servicio. Se copia del de la organización al fijar
  // la tarifa y queda congelado, para que cambiar el % general no reescriba
  // servicios ya acordados.
  comisionPorcentaje Decimal? @db.Decimal(5, 2)

  // Importe de una jornada al precio y la duración de arriba. Se recalcula
  // solo cuando se cambian esos dos; el resto del sistema (facturación,
  // glosario de pagos) sigue leyendo de aquí.
  tarifaImporte Decimal?    @db.Decimal(10, 2)
  tarifaTipo    TipoTarifa?
  tarifaNotas   String?

  // IVA heredado de la necesidad/servicio del catálogo elegido en la
  // solicitud (sección "aplicar el 4% o el 10% de IVA"): igual que
  // comisionImporte, se calcula al fijar la tarifa y queda congelado en el
  // servicio aunque el % del catálogo cambie después.
  ivaPorcentaje Decimal? @db.Decimal(5, 2)
  ivaImporte    Decimal? @db.Decimal(10, 2)
  totalConIva   Decimal? @db.Decimal(10, 2)

  // Compensación al profesional/empresa que presta el servicio — distinta
  // de la tarifa cobrada a la familia. Solo aplica si tarifaTipo = PAGADO.
  pagoProfesionalEstado EstadoPagoProfesional @default(PENDIENTE)

  // Comisión de gestión de CUIDA (sección "cobrar por gestión un pequeño
  // porcentaje"): se calcula al fijar la tarifa, a partir del % de la
  // organización. importeProfesional = tarifaImporte - comisionImporte es lo
  // que se liquida al profesional/empresa; comisionImporte es el margen de
  // CUIDA. Ambos quedan congelados en el servicio aunque cambie luego el %
  // de la organización, para no alterar liquidaciones ya calculadas.
  comisionImporte    Decimal? @db.Decimal(10, 2)
  importeProfesional Decimal? @db.Decimal(10, 2)

  // Servicio facturado: se enlaza a la factura mensual de la persona cuando
  // se genera (sección "cuenta mensual... al final de mes se le cobrará").
  facturaId String?
  factura   Factura? @relation(fields: [facturaId], references: [id])

  visitas         Visita[]
  incidencias     Incidencia[]
  estadoHistorial EstadoHistorial[]
  documentos      Documento[]
  interesados     ServicioInteres[]

  @@map("servicios")
}

// Candidatura de un profesional a un servicio publicado sin asignar todavía
// (sección "sale en la búsqueda para ser aceptado por los profesionales...
// a Carmen le sale una nueva publicación... ella acepta"): coordinación ve
// la lista de interesados y elige, en vez de depender de una notificación
// suelta sin registro consultable.
model ServicioInteres {
  id        String   @id @default(cuid())
  mensaje   String?
  createdAt DateTime @default(now())

  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id])

  @@unique([servicioId, profesionalId])
  @@map("servicio_interesados")
}

enum EstadoFactura {
  BORRADOR
  EMITIDA
  // Cobrada de verdad: el dinero ha entrado. "PAGADA" se mantiene como
  // sinónimo histórico para no romper las facturas ya creadas.
  PAGADA
  IMPAGADA
  ANULADA
}

// Una rectificativa no corrige la original: la referencia y la compensa. La
// factura emitida nunca se toca, que es justamente lo que la hace fiable.
enum TipoFactura {
  ORDINARIA
  RECTIFICATIVA
}

enum FormaPago {
  DOMICILIACION
  TRANSFERENCIA
  EFECTIVO
  TARJETA
}

enum EstadoMandato {
  ACTIVO
  REVOCADO
}

enum EstadoRemesa {
  BORRADOR
  GENERADA
  ENVIADA
  COBRADA
}

// Cómo trabaja quien presta el servicio. Cambia todo lo que viene detrás: a
// un autónomo se le liquida con retención de IRPF y él factura; a un
// empleado se le resume la jornada para que la gestoría haga la nómina.
enum TipoRelacionProfesional {
  LABORAL
  AUTONOMO
}

// Qué papel es. Tiparlos permite exigir los obligatorios y avisar de las
// caducidades; con un nombre libre no se puede comprobar nada.
enum TipoDocumento {
  DNI
  // Certificación negativa del Registro Central de Delincuentes Sexuales.
  // En España es obligatoria para trabajar con personas vulnerables, así que
  // su ausencia no es un descuido administrativo: es un impedimento legal.
  DELITOS_SEXUALES
  TITULACION
  CONTRATO
  ALTA_SEGURIDAD_SOCIAL
  CARNE_CONDUCIR
  SEGURO
  FORMACION
  OTRO
}

enum TipoContrato {
  INDEFINIDO
  TEMPORAL
  FIJO_DISCONTINUO
  PRACTICAS
  // Quien factura no tiene contrato laboral: se guarda para que el expediente
  // no mienta diciendo que sí.
  MERCANTIL
}

enum TipoAusencia {
  VACACIONES
  BAJA_MEDICA
  PERMISO_RETRIBUIDO
  ASUNTOS_PROPIOS
  EXCEDENCIA
  OTRO
}

enum EstadoAusencia {
  SOLICITADA
  APROBADA
  RECHAZADA
  CANCELADA
}

enum EstadoLiquidacion {
  BORRADOR
  APROBADA
  PAGADA
}

// Facturación mensual a la familia (sección "función es cobrar por gestión
// un pequeño porcentaje... al final de mes se le cobrará el importe"):
// agrupa los servicios PAGADO de una persona en un mes natural, calcula el
// total cobrado, la comisión retenida y el neto a liquidar a profesionales.
// Registro de facturación del RD 1007/2023 (el "reglamento Veri*factu"). Cada
// factura que se emite genera un registro de alta encadenado con el anterior
// por una huella SHA-256, de forma que no se puede borrar ni reordenar una
// factura sin que la cadena deje de cuadrar.
//
// La huella se calcula con los campos y el orden que fija la Orden
// HAC/1177/2024. Esto no sustituye al envío a la AEAT ni a la declaración
// responsable del fabricante del software: es la parte que le toca a la
// aplicación — que lo emitido quede registrado, encadenado y sin poder
// alterarse.
model RegistroFacturacion {
  id             String       @id @default(cuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])
  facturaId      String       @unique
  factura        Factura      @relation(fields: [facturaId], references: [id])

  // Los campos que entran en la huella, guardados tal cual entraron: si mañana
  // alguien cambia el NIF de la empresa, la huella de lo ya emitido se tiene
  // que seguir pudiendo recalcular.
  nifEmisor        String
  numSerieFactura  String
  fechaExpedicion  String // dd-mm-aaaa, como pide la orden
  tipoFactura      String // F1 factura completa, R1..R5 rectificativas
  cuotaTotal       Decimal @db.Decimal(12, 2)
  importeTotal     Decimal @db.Decimal(12, 2)
  huellaAnterior   String?
  huella           String
  fechaHoraHusoGen String // ISO 8601 con huso horario

  // Qué programa lo generó. El reglamento obliga a identificarlo en el
  // registro.
  sistemaInformatico String
  versionSistema     String

  // Lo que se imprime en la factura para poder cotejarla.
  urlCotejo String

  createdAt DateTime @default(now())

  @@index([organizacionId, createdAt])
  @@map("registros_facturacion")
}

model Factura {
  id     String @id @default(cuid())
  codigo String @unique // FAC-000012

  // Identidad fiscal del documento. El código interno sirve para buscar; lo
  // que identifica la factura ante Hacienda y ante el cliente es serie +
  // número dentro del ejercicio, correlativo y sin huecos.
  serie            String      @default("A")
  // Nulo mientras es borrador: un borrador todavía no tiene número fiscal, y
  // si ocupara uno solo cabría un borrador por serie y ejercicio. El número
  // se asigna al emitir, y desde entonces ya no cambia.
  numero           Int?
  ejercicio        Int         @default(2026)
  tipo             TipoFactura @default(ORDINARIA)
  fechaEmision     DateTime?
  fechaVencimiento DateTime?
  fechaCobro       DateTime?
  formaPago        FormaPago   @default(DOMICILIACION)

  // Datos del cliente CONGELADOS en el momento de emitir. Si mañana la hija
  // cambia de dirección, la factura que ya se entregó no puede cambiar con
  // ella: dejaría de coincidir con la copia del cliente y con lo declarado.
  titularNombre    String?
  titularNif       String?
  titularDireccion String?
  // Lo mismo con quien emite.
  emisorNombre     String?
  emisorCif        String?
  emisorDireccion  String?
  // El pie registral de una sociedad es mención obligatoria de la factura
  // (art. 24 LSC). Se congela como el resto de la identidad: si mañana cambia
  // el tomo, la factura de ayer sigue diciendo lo que decía al emitirse.
  emisorRegistro   String?

  // Una rectificativa apunta a la que corrige y no la modifica.
  facturaRectificadaId String?
  facturaRectificada   Factura?  @relation("Rectificativas", fields: [facturaRectificadaId], references: [id])
  rectificativas       Factura[] @relation("Rectificativas")
  motivoRectificacion  String?
  motivoImpago         String?

  mandatoSepaId String?
  mandatoSepa   MandatoSepa? @relation(fields: [mandatoSepaId], references: [id])

  remesaId String?
  remesa   Remesa? @relation(fields: [remesaId], references: [id])

  mes                  String // "2026-09"
  // importeTotal es la base imponible (suma de tarifas sin IVA); ivaTotal y
  // totalConIva se añaden aparte para poder emitir una factura con IVA
  // desglosado (sección "aplicar el 4% o el 10% de IVA").
  importeTotal         Decimal       @db.Decimal(10, 2)
  ivaTotal             Decimal       @default(0) @db.Decimal(10, 2)
  totalConIva          Decimal       @default(0) @db.Decimal(10, 2)
  comisionTotal        Decimal       @db.Decimal(10, 2)
  importeProfesionales Decimal       @db.Decimal(10, 2)
  estado               EstadoFactura @default(BORRADOR)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id])

  servicios           Servicio[]
  visitas             Visita[]
  lineas              LineaFactura[]
  registroFacturacion RegistroFacturacion?

  @@unique([personaId, mes])
  // La numeración es única dentro de su serie y ejercicio: es lo que impide
  // que dos facturas compartan número.
  @@unique([organizacionId, serie, ejercicio, numero])
  @@map("facturas")
}

// Las líneas se escriben al emitir y ya no se recalculan. Antes la factura se
// derivaba de las visitas cada vez que se pintaba, así que verificar una
// jornada más tarde cambiaba una factura ya entregada.
model LineaFactura {
  id        String  @id @default(cuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  orden          Int     @default(0)
  concepto       String
  // Se factura tiempo: la cantidad son horas y el precio, el de la hora.
  minutos        Int?
  cantidad       Decimal @default(1) @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(10, 2)
  importe        Decimal @db.Decimal(10, 2)
  ivaPorcentaje  Decimal @default(0) @db.Decimal(5, 2)
  ivaImporte     Decimal @default(0) @db.Decimal(10, 2)

  visitaId String?

  @@map("lineas_factura")
}

// Un envío de recibos domiciliados al banco: agrupa las facturas de un mes
// que se cobran por domiciliación y produce el fichero que se sube.
model Remesa {
  id         String       @id @default(cuid())
  codigo     String       @unique // REM-000003
  mes        String // "2026-09"
  fechaCargo DateTime
  estado     EstadoRemesa @default(BORRADOR)
  // El fichero SEPA generado, guardado tal cual se entregó al banco.
  ficheroXml String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  facturas Factura[]

  @@map("remesas")
}

// Chat entre la persona/familia y un profesional (sección "el panel de
// chat debe ser más intuitivo, no una caja por cada servicio... si es el
// mismo profesional se debe poder visualizar todo junto"): la conversación
// se ancla al par (persona, profesional), no a un servicio concreto — así
// un profesional con varios servicios para la misma familia tiene un único
// hilo, no uno repetido por cada uno.
model Mensaje {
  id        String   @id @default(cuid())
  texto     String
  createdAt DateTime @default(now())

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id])

  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id])

  autorUsuarioId String
  autor          Usuario @relation(fields: [autorUsuarioId], references: [id])

  @@map("mensajes")
}

enum EstadoVisita {
  PROGRAMADA
  CONFIRMADA
  EN_CURSO
  FINALIZADA
  INCIDENCIA
  REVISADA
  // La jornada no se hizo. Son tres cosas distintas y con consecuencia
  // económica distinta: en una cancelación nadie se desplazó; en un no
  // presentado el profesional fue y la persona no estaba; en una falta del
  // profesional no fue nadie a casa de la persona.
  CANCELADA
  NO_PRESENTADO
  // No fue nadie. Ni se cobra —no se prestó el servicio— ni se paga —no se
  // trabajó—, y deja a alguien esperando en su casa: es lo más grave que
  // puede pasar en este negocio, así que abre incidencia sola.
  FALTA_PROFESIONAL
  // Verificada y ya incluida en una liquidación al profesional.
  LIQUIDADA
}

model Visita {
  id             String       @id @default(cuid())
  codigo         String       @unique // VIS-001923
  fecha          DateTime
  horaInicioProg String?
  horaFinProg    String?
  horaInicioReal DateTime?
  horaFinReal    DateTime?
  estado         EstadoVisita @default(PROGRAMADA)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  // Snapshot del profesional que hizo la visita (sección "poder cambiar de
  // profesional si este se enferma... y que esto se tenga en cuenta en su
  // facturación"): se copia de servicio.profesionalId al crear la visita, y
  // ya no cambia aunque el servicio se reasigne después — así el historial
  // de horas por profesional no se corrompe con una reasignación posterior.
  profesionalId String?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])

  // Facturación por horas de servicios recurrentes (sección "las que son
  // recurrentes... se facturan"): un servicio RECURRENTE nunca se cierra,
  // así que se factura por periodo a partir de las horas reales de sus
  // visitas de ese mes, no a partir del propio Servicio como en PUNTUAL.
  facturaId String?
  factura   Factura? @relation(fields: [facturaId], references: [id])

  // --- Motor de tiempo -----------------------------------------------------
  // Los cuatro tiempos de una visita, separados a propósito. Antes solo se
  // guardaban las horas y cada pantalla volvía a calcular lo suyo, así que la
  // misma jornada podía valer 3 h en un sitio y 2 h 54 min en otro.
  minutosProgramados Int? // lo acordado: de horaInicioProg a horaFinProg
  minutosReales      Int? // lo fichado: de horaInicioReal a horaFinReal
  minutosFacturables Int? // lo que se cobra a la familia, según la regla
  minutosLiquidables Int? // lo que cobra el profesional, según la regla

  // Cómo se llegó a las dos últimas cifras, en una frase que se puede enseñar
  // tal cual cuando alguien pregunta "¿por qué 3 horas?".
  explicacionTiempo String?

  // --- Instantánea de la tarifa aplicada -----------------------------------
  // Congelada al cerrar la visita. Cambiar la tarifa después no reescribe lo
  // ya prestado: la visita de septiembre sigue a su precio de septiembre.
  tarifaId              String?
  precioHoraCliente     Decimal? @db.Decimal(10, 2)
  precioHoraProfesional Decimal? @db.Decimal(10, 2)

  importeCliente     Decimal? @db.Decimal(10, 2)
  importeProfesional Decimal? @db.Decimal(10, 2)
  importeCuida       Decimal? @db.Decimal(10, 2)

  // --- Desviación y aprobación ---------------------------------------------
  // El tiempo de más no se cobra solo: se detecta, se razona y se aprueba.
  retrasoMinutos      Int?
  desviacionMinutos   Int? // real - programado; negativo si salió antes
  ajusteEstado        EstadoAjuste      @default(SIN_AJUSTE)
  ajusteMotivo        MotivoDesviacion?
  ajusteNota          String?
  ajusteDecididoAt    DateTime?
  ajusteDecididoPorId String?
  ajusteDecididoPor   Usuario?          @relation("VisitaAjusteDecididoPor", fields: [ajusteDecididoPorId], references: [id])

  // Cerrada por coordinación porque el profesional olvidó fichar la salida.
  // Que sea un cierre manual tiene que verse: no es un fichaje.
  cierreManual        Boolean  @default(false)
  cerradoPorUsuarioId String?
  cerradoPor          Usuario? @relation("VisitaCerradaPor", fields: [cerradoPorUsuarioId], references: [id])

  tareas              Tarea[]
  actuaciones         Actuacion[]
  incidencias         Incidencia[]
  documentos          Documento[]
  estadoHistorial     EstadoHistorial[]
  correccionesFichaje CorreccionFichaje[]

  @@map("visitas")
}

model Tarea {
  id          String   @id @default(cuid())
  visitaId    String
  visita      Visita   @relation(fields: [visitaId], references: [id])
  descripcion String
  completada  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("tareas")
}

// "Lo ocurrido": observación registrada durante o al cierre de la visita.
// Nunca sustituye una historia clínica ni un diagnóstico (sección 14).
model Actuacion {
  id          String   @id @default(cuid())
  visitaId    String
  visita      Visita   @relation(fields: [visitaId], references: [id])
  descripcion String
  createdAt   DateTime @default(now())

  @@map("actuaciones")
}

enum EstadoIncidencia {
  NUEVA
  EN_REVISION
  ASIGNADA
  EN_RESOLUCION
  RESUELTA
  CERRADA
}

enum PrioridadIncidencia {
  BAJA
  MEDIA
  ALTA
}

enum TipoIncidencia {
  GENERAL
  SOLICITUD_CANCELACION
}

enum MotivoIncidencia {
  SALUD // caída, malestar, un susto
  ACCESO // no se puede entrar: llaves, portal, nadie abre
  AUSENCIA // el profesional o la persona no estaban
  RETRASO
  TRATO // desacuerdo o queja sobre el trato
  MATERIAL // falta material o algo está estropeado
  HORARIO // cambio o confusión de horario
  // Las horas fichadas no cuadran con lo acordado: se ha trabajado de más,
  // de menos, o coordinación quiere confirmarlo antes de verificar. Es el
  // camino cuando no cuadra un fichaje, porque el fichaje no se reescribe.
  HORAS
  OTRO
}

model Incidencia {
  id          String              @id @default(cuid())
  codigo      String              @unique // INC-000045
  tipo        TipoIncidencia      @default(GENERAL)
  // Motivo: de qué va la incidencia, en una palabra. Es lo que permite
  // agrupar y filtrar ("¿cuántas caídas llevamos este mes?"); la descripción
  // cuenta el caso concreto y no se puede agrupar por ella.
  motivo      MotivoIncidencia    @default(OTRO)
  descripcion String
  prioridad   PrioridadIncidencia @default(MEDIA)
  estado      EstadoIncidencia    @default(NUEVA)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  visitaId String?
  visita   Visita? @relation(fields: [visitaId], references: [id])

  servicioId String?
  servicio   Servicio? @relation(fields: [servicioId], references: [id])

  responsableUsuarioId String?
  responsable          Usuario? @relation("IncidenciaResponsable", fields: [responsableUsuarioId], references: [id])

  // Quién la abrió. Sin esto, en la ficha ponía el caso pero no de quién
  // venía el aviso, y coordinación no sabía a quién llamar para
  // preguntar. Opcional porque las incidencias anteriores no lo guardaban.
  creadoPorUsuarioId String?
  creadoPor          Usuario? @relation("IncidenciaCreadaPor", fields: [creadoPorUsuarioId], references: [id])

  estadoHistorial EstadoHistorial[]

  @@map("incidencias")
}

// ---------------------------------------------------------------------------
// Documentos, notificaciones, historial de estados y auditoría
// ---------------------------------------------------------------------------

model Documento {
  id             String        @id @default(cuid())
  nombre         String
  // Enlace externo, cuando el papel vive en otro sitio. Se mantiene porque no
  // todo documento es un fichero que subamos nosotros, pero un documento
  // obligatorio sin archivo cuenta como que falta.
  url            String
  // Tipo, vigencia y notas. Un documento sin tipo ni caducidad no se puede
  // reclamar a tiempo: se descubre que faltaba el día que hace falta.
  tipo           TipoDocumento @default(OTRO)
  fechaEmision   DateTime?
  fechaCaducidad DateTime?
  notas          String?
  createdAt      DateTime      @default(now())

  // El fichero de verdad, cuando lo hay.
  archivoId String?
  archivo   Archivo? @relation(fields: [archivoId], references: [id])

  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id])

  servicioId String?
  servicio   Servicio? @relation(fields: [servicioId], references: [id])

  visitaId String?
  visita   Visita? @relation(fields: [visitaId], references: [id])

  // Documentos del propio profesional (sección "ver toda su información,
  // documentación... un perfil completamente avanzado"): DNI, certificados,
  // etc. — no atados a un servicio ni a una persona atendida.
  profesionalId String?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])

  @@map("documentos")
}

model Notificacion {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tipo      String
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  // Referencia a la ficha que debe abrir el frontend al pinchar la
  // notificación (normalmente una Solicitud — la vista unificada).
  entidadTipo String?
  entidadId   String?

  @@map("notificaciones")
}

// Historial de solo-inserción de cambios de estado. Cada transición registra
// quién, cuándo, estado anterior, nuevo estado y motivo (sección 8).
model EstadoHistorial {
  id             String   @id @default(cuid())
  entidadTipo    String // "Solicitud" | "Servicio" | "Visita" | "Incidencia"...
  estadoAnterior String?
  estadoNuevo    String
  motivo         String?
  createdAt      DateTime @default(now())

  solicitudId  String?
  solicitud    Solicitud?  @relation(fields: [solicitudId], references: [id])
  servicioId   String?
  servicio     Servicio?   @relation(fields: [servicioId], references: [id])
  visitaId     String?
  visita       Visita?     @relation(fields: [visitaId], references: [id])
  incidenciaId String?
  incidencia   Incidencia? @relation(fields: [incidenciaId], references: [id])

  @@map("estado_historial")
}

// Auditoría: quién / cuándo / qué acción, nunca modificable ni borrable
// desde la aplicación (append-only).
model AuditLog {
  id          String   @id @default(cuid())
  accion      String // "login", "ver_persona", "crear_solicitud", "cambiar_estado"...
  entidadTipo String?
  entidadId   String?
  detalle     String?
  createdAt   DateTime @default(now())

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  organizacionId String?
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])

  @@map("audit_logs")
}

// Lo que se le debe a un profesional por un mes. Hasta ahora sólo existía un
// sí/no de pagado colgando del servicio: no había manera de decirle "esto es
// lo que has hecho y esto es lo que cobras", ni de darle un papel.
model Liquidacion {
  id     String @id @default(cuid())
  codigo String @unique // LIQ-000007
  mes    String // "2026-09"

  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id])

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  // La relación laboral queda congelada en la liquidación: si mañana pasa de
  // autónoma a contratada, lo ya liquidado siguió sus reglas.
  tipoRelacion   TipoRelacionProfesional
  minutos        Int                     @default(0)
  bruto          Decimal                 @default(0) @db.Decimal(10, 2)
  // Retención de IRPF: sólo tiene sentido en los autónomos.
  irpfPorcentaje Decimal                 @default(0) @db.Decimal(5, 2)
  irpfImporte    Decimal                 @default(0) @db.Decimal(10, 2)
  neto           Decimal                 @default(0) @db.Decimal(10, 2)

  estado         EstadoLiquidacion @default(BORRADOR)
  fechaPago      DateTime?
  referenciaPago String?
  notas          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lineas LineaLiquidacion[]

  @@unique([profesionalId, mes])
  @@map("liquidaciones")
}

model LineaLiquidacion {
  id            String      @id @default(cuid())
  liquidacionId String
  liquidacion   Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  visitaId String?
  fecha    DateTime
  concepto String
  minutos  Int
  importe  Decimal  @db.Decimal(10, 2)

  @@map("lineas_liquidacion")
}

// Los días que alguien no está. Una ausencia aprobada no es información
// administrativa: es lo que impide que coordinación le asigne una jornada ese
// día y descubra el problema cuando nadie aparece en casa de la persona.
model Ausencia {
  id     String         @id @default(cuid())
  tipo   TipoAusencia
  estado EstadoAusencia @default(SOLICITADA)

  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  // Días completos, inclusive los dos extremos.
  desde DateTime
  hasta DateTime

  motivo               String?
  respuesta            String? // por qué se aprueba o se rechaza
  resueltaPorUsuarioId String?
  resueltaAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("ausencias")
}

// Registro de jornada mensual (Art. 34.9 del Estatuto de los Trabajadores).
// La obligación es registrar el horario concreto de inicio y fin de cada día
// y conservarlo cuatro años a disposición de la Inspección.
//
// Los fichajes ya viven en las visitas; esto es el documento: se congela un
// resumen del mes para que siga significando lo mismo aunque después se
// reasignen servicios o se corrijan jornadas, y el trabajador da su
// conformidad.
model RegistroJornada {
  id     String @id @default(cuid())
  codigo String @unique // REG-000012
  mes    String // "2026-09"

  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  organizacionId String

  minutosTrabajados Int  @default(0)
  // Horas de contrato del mes, para poder ver exceso o defecto. Nulo cuando
  // no hay contrato laboral.
  minutosContrato   Int?
  diasTrabajados    Int  @default(0)

  // El detalle día a día, congelado en el momento de cerrar el mes.
  detalle String // JSON: [{ fecha, entrada, salida, minutos, servicio }]

  cerradoAt    DateTime  @default(now())
  conformeAt   DateTime?
  conformeNota String?
  createdAt    DateTime  @default(now())

  @@unique([profesionalId, mes])
  @@map("registros_jornada")
}

// ---------------------------------------------------------------------------
// Motor de tiempo y economía trazable
//
// CUIDA cobra por tiempo, así que el tiempo es la unidad económica y no puede
// ser un único número ambiguo. Un servicio puede estar programado de 09:00 a
// 12:00, ficharse de 09:04 a 11:58 y facturarse como 3 h: son tres cifras
// distintas y las tres tienen que poder verse, porque responden a preguntas
// distintas ("¿qué acordamos?", "¿qué pasó?", "¿qué se cobra?").
//
// Lo que decide la conversión de una en otra es una regla de negocio, no el
// código: cada organización cobra y paga a su manera.
// ---------------------------------------------------------------------------

// De dónde sale el tiempo que se convierte en dinero.
enum BaseTiempo {
  PROGRAMADO // lo acordado en el plan, pase lo que pase en el fichaje
  REAL // lo efectivamente fichado
  MENOR // el menor de los dos (prudente para el cliente)
  MAYOR // el mayor de los dos (prudente para el profesional)
}

enum ModoRedondeo {
  NINGUNO
  ARRIBA
  ABAJO
  CERCANO
}

// Por qué hay más (o menos) tiempo del acordado. Obligatorio al pedir que se
// apruebe una desviación: sin motivo no se puede decidir.
enum MotivoDesviacion {
  PETICION_CLIENTE
  NECESIDAD_DEL_SERVICIO
  INCIDENCIA
  ERROR_DE_FICHAJE
  OTRO
}

enum EstadoAjuste {
  SIN_AJUSTE
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Las reglas que convierten tiempo en dinero. Una por organización, editables
// desde Administración: son decisiones comerciales, no constantes del código.
model ReglasNegocio {
  id             String       @id @default(cuid())
  organizacionId String       @unique
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  // Tiempo → dinero. Por defecto se cobra y se paga lo acordado: es lo que la
  // familia espera en la factura y lo que el profesional espera en su nómina,
  // y evita que cuatro minutos de más o de menos muevan el importe.
  baseCobro       BaseTiempo @default(PROGRAMADO)
  baseLiquidacion BaseTiempo @default(PROGRAMADO)

  // Redondeo del tiempo resultante. 0 minutos = no se redondea.
  redondeoMinutos Int          @default(0)
  redondeoModo    ModoRedondeo @default(NINGUNO)
  // Nadie factura una visita de siete minutos: por debajo de esto se cobra el
  // mínimo. 0 = sin mínimo.
  minimoMinutos   Int          @default(0)

  // Cuánto se puede desviar el fichaje de lo acordado antes de que deje de ser
  // ruido y pase a ser algo que alguien tiene que mirar.
  toleranciaRetrasoMinutos Int     @default(10)
  toleranciaExcesoMinutos  Int     @default(10)
  // El tiempo de más no se cobra solo: se propone y coordinación decide.
  aprobarTiempoExtra       Boolean @default(true)

  // Una visita iniciada y nunca cerrada suele ser un olvido, no una jornada de
  // nueve horas. A partir de estas horas el escritorio la señala.
  horasVisitaAbierta Int @default(4)

  // Cancelaciones: con preaviso no cuesta nada; sin él, el profesional ya había
  // reservado el hueco y la regla dice cuánto se cobra y cuánto se le paga.
  cancelacionAvisoHoras  Int     @default(24)
  cancelacionTardiaCobro Decimal @default(50) @db.Decimal(5, 2)
  cancelacionTardiaPago  Decimal @default(50) @db.Decimal(5, 2)

  // No presentado: el profesional fue y la persona no estaba. El servicio no se
  // hizo, pero el desplazamiento y el hueco sí existieron.
  noPresentadoCobro Decimal @default(100) @db.Decimal(5, 2)
  noPresentadoPago  Decimal @default(100) @db.Decimal(5, 2)

  // Lo mínimo que se puede pagar por hora de trabajo. El valor que trae es el
  // suelo del SMI: 1.184 €/mes × 14 pagas ÷ 1.826 horas de jornada anual
  // máxima (RD 87/2025 y art. 34 del Estatuto de los Trabajadores) ≈ 9,08 €/h.
  // El convenio de ayuda a domicilio que aplique suele estar por encima, así
  // que esto es configurable y hay que subirlo a lo que diga el convenio: aquí
  // solo impide lo que es ilegal en cualquier caso.
  salarioMinimoHora Decimal @default(9.08) @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reglas_negocio")
}

// El precio no se guarda suelto en cada servicio: se guarda una tarifa con
// vigencia, y la visita se queda con una instantánea de la que se le aplicó.
// Así subir el precio en octubre no reescribe lo facturado en septiembre.
model Tarifa {
  id             String       @id @default(cuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  nombre      String
  // Opcional: una tarifa puede ser general o específica de un tipo de servicio.
  necesidadId String?
  necesidad   NecesidadCatalogo? @relation(fields: [necesidadId], references: [id])

  precioHoraCliente     Decimal @db.Decimal(10, 2)
  precioHoraProfesional Decimal @db.Decimal(10, 2)

  vigenteDesde DateTime
  vigenteHasta DateTime?
  activa       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tarifas")
}

// Un fichaje no se sobrescribe. Si coordinación corrige una hora, el dato
// original sigue ahí y queda quién lo cambió, a qué y por qué.
model CorreccionFichaje {
  id       String @id @default(cuid())
  visitaId String
  visita   Visita @relation(fields: [visitaId], references: [id], onDelete: Cascade)

  campo         String // "horaInicioReal" | "horaFinReal"
  valorAnterior DateTime?
  valorNuevo    DateTime?
  motivo        String

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@map("correcciones_fichaje")
}

// ---------------------------------------------------------------------------
// Almacén de archivos
//
// Hasta ahora un documento era una fila con un nombre y una URL de texto
// libre, casi siempre vacía: CUIDA sabía que el certificado de delitos
// sexuales "existía" pero no lo tenía. Para un papel que la ley exige tener,
// eso no es tener nada.
//
// El fichero se guarda fuera de la base de datos y aquí queda su ficha: qué
// es, cuánto pesa, de qué tipo es de verdad —comprobado por sus primeros
// bytes, no por lo que diga quien lo sube—, su huella para saber si ha
// cambiado, y quién lo subió y cuándo.
// ---------------------------------------------------------------------------
model Archivo {
  id String @id @default(cuid())

  // El nombre con el que lo subieron, solo para enseñarlo y para la descarga.
  // Nunca se usa como ruta: un nombre de fichero es texto del usuario.
  nombre   String
  tipoMime String
  bytes    Int
  // SHA-256 del contenido. Sirve para detectar un fichero corrupto o alterado
  // y para no guardar dos veces el mismo papel.
  hash     String

  // Dónde está, relativo a la carpeta del almacén. Lo decide el servidor.
  ruta String

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  subidoPorId String
  subidoPor   Usuario @relation("ArchivoSubidoPor", fields: [subidoPorId], references: [id])

  createdAt DateTime @default(now())

  documentos      Documento[]
  consentimientos Consentimiento[]
  encargos        EmpresaColaboradora[] @relation("EncargoTratamiento")

  @@index([organizacionId])
  @@index([hash])
  @@map("archivos")
}

// ---------------------------------------------------------------------------
// Conservación de datos
//
// El RGPD exige guardar los datos personales "durante el tiempo necesario", y
// eso tiene dos filos: guardar de menos incumple la obligación de conservar
// —el registro de jornada, la factura—, y guardar de más incumple el
// principio de limitación del plazo. Las dos cosas son infracción.
//
// Los plazos de abajo son los que se citan habitualmente en España y cada uno
// lleva escrita la norma de la que sale. No son asesoría jurídica: son un
// punto de partida que la asesoría de cada organización confirma o cambia
// desde Administración, sin tocar el código.
// ---------------------------------------------------------------------------
model PoliticaConservacion {
  id             String       @id @default(cuid())
  organizacionId String       @unique
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  // Registro de jornada. Art. 34.9 del Estatuto de los Trabajadores: cuatro
  // años a disposición de la Inspección de Trabajo.
  mesesRegistroJornada Int @default(48)

  // Documentación laboral (contratos, altas, titulaciones). Cuatro años, por
  // el plazo de prescripción de las infracciones del art. 21 de la LISOS y
  // por las obligaciones de conservación frente a la Seguridad Social.
  mesesDocumentacionLaboral Int @default(48)

  // Facturación y contabilidad. Seis años por el art. 30 del Código de
  // Comercio, que es más largo que los cuatro de prescripción tributaria del
  // art. 66 de la Ley General Tributaria: manda el más largo.
  mesesFacturacion Int @default(72)

  // Mandato SEPA: mientras esté vigente y un tiempo después del último
  // adeudo, para poder atender una devolución. Catorce meses es el plazo de
  // reclamación por adeudo no autorizado del cuaderno SEPA.
  mesesMandatoSepa Int @default(14)

  // Datos asistenciales de la persona tras el último servicio. Cinco años por
  // el plazo general de prescripción de acciones personales del art. 1964 del
  // Código Civil.
  mesesDatosAsistenciales Int @default(60)

  // Certificado de delitos sexuales tras la baja del profesional. No hay plazo
  // fijado: el principio de minimización pide guardarlo lo justo para poder
  // acreditar que se comprobó. Un año es prudente y corto.
  mesesCertificadoPenales Int @default(12)

  // Registro de accesos y auditoría. Dos años, alineado con lo que pide el
  // Esquema Nacional de Seguridad para trazas de acceso.
  mesesAuditoria Int @default(24)

  // Mensajes entre la familia y el profesional. No hay obligación de
  // conservarlos; un año cubre una reclamación razonable.
  mesesMensajes Int @default(12)

  // Quién responde de protección de datos, para poder ponerlo en la
  // información que se entrega y en la respuesta a un derecho de acceso.
  responsableNombre String?
  responsableEmail  String?
  delegadoNombre    String?
  delegadoEmail     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("politicas_conservacion")
}

// Lo que la persona ha autorizado, y cuándo se le explicó qué se hace con sus
// datos. El RGPD no se cumple teniendo una política colgada en la web: hay que
// poder demostrar (art. 5.2 y 7.1) que a esta persona se le informó, qué se le
// informó y qué consintió — y poder retirarlo con la misma facilidad con que
// se dio (art. 7.3).
//
// Un consentimiento no se edita nunca: se otorga, y si se retira queda el
// otorgamiento con su fecha de revocación al lado. Rescribir la fila borraría
// justo la prueba que el reglamento pide conservar.
model Consentimiento {
  id            String              @id @default(cuid())
  personaId     String
  persona       Persona             @relation(fields: [personaId], references: [id], onDelete: Cascade)
  tipo          TipoConsentimiento
  // Falso = se le preguntó y dijo que no. No es lo mismo que no haber
  // preguntado nunca, que es la ausencia de fila.
  otorgado      Boolean
  // Versión del texto que se le leyó o entregó. Sin esto, dentro de dos años
  // nadie sabe a qué estaba consintiendo.
  version       String
  canal         CanalConsentimiento @default(PRESENCIAL)
  // Quién lo recogió, y el papel firmado si lo hay.
  recogidoPorId String?
  recogidoPor   Usuario?            @relation("ConsentimientoRecogidoPor", fields: [recogidoPorId], references: [id])
  archivoId     String?
  archivo       Archivo?            @relation(fields: [archivoId], references: [id])
  nota          String?

  otorgadoAt       DateTime  @default(now())
  revocadoAt       DateTime?
  revocadoPorId    String?
  revocadoPor      Usuario?  @relation("ConsentimientoRevocadoPor", fields: [revocadoPorId], references: [id])
  motivoRevocacion String?

  @@index([personaId, tipo])
  @@map("consentimientos")
}

enum TipoConsentimiento {
  INFORMACION // art. 13: se le entregó la información del tratamiento
  DATOS_SALUD // art. 9.2.h: medicación, movilidad, lo que hace falta para cuidar
  CESION_PROFESIONAL // sus datos llegan a quien entra en su casa
  IMAGEN // fotografías, vídeo
  COMUNICACIONES // avisos y novedades que no son del servicio contratado
}

enum CanalConsentimiento {
  PRESENCIAL
  TELEFONO
  APLICACION
  PAPEL_FIRMADO
}
