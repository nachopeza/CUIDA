// CUIDA — Modelo de datos, fase 1
//
// Hereda el patrón de IDENTIA: identidad permanente, roles, estados, auditoría,
// multi-tenant por organización desde el principio.
// Añade la capa que faltaba en IDENTIA: necesidad → solicitud → servicio →
// asignación → visita → actuación → seguimiento → cierre.
//
// Regla del masterplan (sección 5): PERSONA ≠ SOLICITUD ≠ SERVICIO ≠ VISITA.
// Una persona puede tener muchas solicitudes y servicios; una modificación
// administrativa nunca debe destruir el historial (por eso el AuditLog y el
// EstadoHistorial son de solo-inserción).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidad, tenancy y roles (heredado de IDENTIA)
// ---------------------------------------------------------------------------

enum EstadoOrganizacion {
  PRUEBA
  ACTIVA
  SUSPENDIDA
  CERRADA
}

model Organizacion {
  id                 String             @id @default(cuid())
  codigo             String             @unique // ORG-00017
  nombre             String
  estado             EstadoOrganizacion @default(PRUEBA)
  // Modelo de negocio (sección "función es cobrar por gestión un pequeño
  // porcentaje"): comisión que se retiene de la tarifa cobrada a la familia
  // antes de liquidar al profesional/empresa colaboradora.
  comisionPorcentaje Decimal            @default(15) @db.Decimal(5, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  usuarios              Usuario[]
  personas              Persona[]
  profesionales         Profesional[]
  empresasColaboradoras EmpresaColaboradora[]
  solicitudes           Solicitud[]
  servicios             Servicio[]
  facturas              Factura[]
  auditLogs             AuditLog[]

  @@map("organizaciones")
}

enum RolUsuario {
  PERSONA
  FAMILIAR
  PROFESIONAL
  COORDINADOR
  ORGANIZACION
  ADMIN
  SUPERADMIN
}

// El acceso a información personal debe estar justificado y limitado a lo
// necesario (AEPD). El rol determina la intención de acceso; los permisos
// finos (qué persona concreta) los otorgan FamiliarRelacion y la pertenencia
// a organización.
model Usuario {
  id           String     @id @default(cuid())
  // Nombre para mostrar (sección "unificar... en un único perfil"): permite
  // identificar a un familiar o cuidador por su nombre en vez de solo por
  // email en listados, chat y actividad. Opcional: el email sigue siendo el
  // identificador de acceso.
  nombre       String?
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  organizacionId String?
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])

  // Un usuario PERSONA está enlazado 1:1 a su ficha de Persona.
  personaId String?  @unique
  persona   Persona? @relation("PersonaUsuario", fields: [personaId], references: [id])

  // Un usuario PROFESIONAL está enlazado 1:1 a su ficha de Profesional.
  profesionalId String?      @unique
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])

  familiarDe           FamiliarRelacion[] @relation("UsuarioFamiliar")
  solicitudesCreadas   Solicitud[]        @relation("SolicitudCreadaPor")
  incidenciasAsignadas Incidencia[]       @relation("IncidenciaResponsable")
  incidenciasCreadas   Incidencia[]       @relation("IncidenciaCreadaPor")
  notificaciones       Notificacion[]
  mensajes             Mensaje[]
  auditLogs            AuditLog[]

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Personas, familiares y profesionales
// ---------------------------------------------------------------------------

enum EstadoPersona {
  PENDIENTE
  ACTIVA
  SUSPENDIDA
  ARCHIVADA
}

model Persona {
  id              String        @id @default(cuid())
  codigo          String        @unique // CUI-000184 (identificador permanente)
  nombre          String
  apellidos       String
  fechaNacimiento DateTime?
  telefono        String?
  direccion       String?
  preferencias    String?
  // Perfil completo (sección "Usuarios" del coordinador): información
  // operativa que necesita quien presta el servicio, nunca una historia
  // clínica (sección 14 — ayuda cotidiana ≠ diagnóstico sanitario).
  contactos       String? // contactos de emergencia, en texto libre
  medicacion      String?
  medico          String? // médico/centro de referencia
  recomendaciones String?
  estado          EstadoPersona @default(PENDIENTE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  usuario     Usuario?           @relation("PersonaUsuario")
  familiares  FamiliarRelacion[]
  solicitudes Solicitud[]
  documentos  Documento[]
  facturas    Factura[]
  mensajes    Mensaje[]

  @@map("personas")
}

// Relación autorizada de un familiar/representante sobre una persona atendida.
// El acceso del familiar se limita a los permisos concedidos aquí, nunca al
// rol por sí solo (principio de minimización, AEPD).
model FamiliarRelacion {
  id                String    @id @default(cuid())
  personaId         String
  persona           Persona   @relation(fields: [personaId], references: [id])
  usuarioId         String
  usuario           Usuario   @relation("UsuarioFamiliar", fields: [usuarioId], references: [id])
  parentesco        String // "Hija", "Hijo", "Cónyuge"...
  esRepresentante   Boolean   @default(false)
  puedeSolicitar    Boolean   @default(true)
  puedeVerHistorial Boolean   @default(true)
  // Ver importes/tarifas es un permiso propio, distinto de ver el historial:
  // una persona atendida (rol PERSONA) nunca ve tarifas; un familiar
  // autorizado las ve solo si se le concede explícitamente este permiso.
  puedeVerImportes  Boolean   @default(true)
  createdAt         DateTime  @default(now())
  revocadoAt        DateTime?

  @@unique([personaId, usuarioId])
  @@map("familiar_relaciones")
}

enum CarneConducir {
  NO
  B // turismo, el habitual
  A // moto
  C // camión
  D // autobús
}

// Titulación de referencia en atención a domicilio, de menos a más.
enum Titulacion {
  SIN_TITULACION
  ATENCION_SOCIOSANITARIA // certificado de profesionalidad
  AUXILIAR_ENFERMERIA // TCAE
  ENFERMERIA
  TRABAJO_SOCIAL
  FISIOTERAPIA
  TERAPIA_OCUPACIONAL
  PSICOLOGIA
  OTRA
}

enum EstadoProfesional {
  PENDIENTE
  VERIFICADO
  ACTIVO
  SUSPENDIDO
  INACTIVO
}

model Profesional {
  id           String            @id @default(cuid())
  codigo       String            @unique // PRO-00031
  nombre       String
  apellidos    String
  telefono     String?
  // Zona de trabajo. Era texto libre y cada quien escribía una cosa
  // ("Centro", "centro", "Santander centro"), así que no se podía filtrar ni
  // agrupar. Ahora son dos códigos de una lista cerrada.
  comunidad    String?
  municipio    String?
  // Se conserva el texto anterior para no perder lo que ya había escrito y
  // para poder afinar ("barrio de la Inmobiliaria", "zona rural").
  zona         String?
  // Lo que hace falta saber para mandarle según qué servicio: si puede
  // conducir, si tiene coche y qué ha estudiado.
  carneConducir   CarneConducir @default(NO)
  vehiculoPropio  Boolean       @default(false)
  titulacion      Titulacion?
  // Datos personales y de cobro (sección "los perfiles de profesionales se
  // deben poder editar e incluir información número de cuenta, Bizum, carné,
  // datos personales..."). Información sensible: solo la ve el propio
  // profesional y los gestores de la organización, nunca la persona atendida.
  dni          String?
  numeroCuenta String?
  bizum        String?
  // Perfil profundo (sección "el perfil de Carmen debe ser más profundo...
  // biografía, tipo CV, para que los familiares también acepten y vean las
  // cualidades de Carmen"): visible para coordinación y para la familia al
  // valorar quién atiende a la persona, nunca solo un nombre en una lista.
  foto         String?
  biografia    String?
  // Disponibilidad semanal (sección "incluir disponibilidad"): JSON con días
  // de la semana y franja horaria — texto libre en BD, estructurado solo en
  // el frontend, para no tener que migrar otra vez si cambia la forma.
  disponibilidad String?
  estado       EstadoProfesional @default(PENDIENTE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  // Si trabaja para una empresa colaboradora (no independiente), se
  // autorrellena al asignarla a un servicio (sección coordinación).
  empresaColaboradoraId String?
  empresaColaboradora   EmpresaColaboradora? @relation(fields: [empresaColaboradoraId], references: [id])

  usuario    Usuario?
  servicios  Servicio[]
  mensajes   Mensaje[]
  interesEn  ServicioInteres[]
  documentos Documento[]
  visitas    Visita[]

  @@map("profesionales")
}

enum EstadoEmpresaColaboradora {
  ACTIVA
  INACTIVA
}

// Empresa externa a la que la organización puede subcontratar un servicio,
// en vez de (o además de) asignarlo a un profesional interno.
model EmpresaColaboradora {
  id           String                    @id @default(cuid())
  codigo       String                    @unique // EXT-00001
  nombre       String
  contacto     String?
  // Datos administrativos/de cobro, editables desde coordinación (igual que
  // en el perfil de profesional independiente).
  cif          String?
  direccion    String?
  numeroCuenta String?
  estado       EstadoEmpresaColaboradora @default(ACTIVA)
  createdAt    DateTime                  @default(now())

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  servicios     Servicio[]
  profesionales Profesional[]

  @@map("empresas_colaboradoras")
}

// ---------------------------------------------------------------------------
// Catálogo de servicios (lenguaje humano → dato estructurado, y también lo
// que la organización factura). Antes había dos catálogos parecidos —
// "necesidades" (cómo lo pide la persona: compra, acompañamiento...) y un
// catálogo aparte solo para el IVA de facturación — que eran la misma idea
// contada dos veces (sección "unifiquemos: Servicios son lo que ofrecemos,
// Solicitudes son las que nos hacen los usuarios"). Ahora es uno solo: cada
// Servicio del catálogo ya lleva su % de IVA (4% superreducido para plazas
// concertadas/prestación vinculada a dependencia, 10% reducido para
// contratación particular), y una Solicitud simplemente elige uno.
model NecesidadCatalogo {
  id            String   @id @default(cuid())
  codigo        String   @unique // "compra", "acompanamiento", "compania"...
  nombre        String
  descripcion   String?
  ivaPorcentaje Decimal  @default(4) @db.Decimal(5, 2)
  precioBase    Decimal? @db.Decimal(10, 2)
  activo        Boolean  @default(true)

  solicitudes Solicitud[]

  @@map("necesidades_catalogo")
}

// ---------------------------------------------------------------------------
// Cadena funcional de CUIDA: necesidad → solicitud → servicio → visita →
// actuación → seguimiento → cierre
// ---------------------------------------------------------------------------

enum EstadoSolicitud {
  BORRADOR
  ENVIADA
  EN_REVISION
  BUSCANDO
  PROPUESTA
  ACEPTADA
  CANCELADA
  CERRADA
}

model Solicitud {
  id               String          @id @default(cuid())
  codigo           String          @unique // SOL-000582
  descripcionLibre String // texto tal cual lo pide la persona/familiar
  estado           EstadoSolicitud @default(BORRADOR)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id])

  necesidadId String
  necesidad   NecesidadCatalogo @relation(fields: [necesidadId], references: [id])

  creadaPorUsuarioId String
  creadaPor          Usuario @relation("SolicitudCreadaPor", fields: [creadaPorUsuarioId], references: [id])

  plan     Plan?
  servicio Servicio?

  estadoHistorial EstadoHistorial[]

  @@map("solicitudes")
}

model Plan {
  id              String    @id @default(cuid())
  solicitudId     String    @unique
  solicitud       Solicitud @relation(fields: [solicitudId], references: [id])
  fechaInicio     DateTime
  // Nula = indefinido / hasta nuevo aviso (sección "si necesita a alguien
  // para indefinido"): un servicio recurrente sin fecha de fin conocida
  // todavía, en vez de forzar una fecha ficticia.
  fechaFin        DateTime?
  recurrencia     String? // "diaria", "L-V", "puntual"...
  franjaHoraria   String? // "Mañana", "Tarde", "Todo el día"...
  horaInicio      String? // "09:00"
  horaFin         String? // "12:00"
  tareasPrevistas String? // lista libre inicial de tareas esperadas
  notas           String?
  createdAt       DateTime  @default(now())

  @@map("planes")
}

enum EstadoServicio {
  PENDIENTE
  ASIGNADO
  CONFIRMADO
  EN_CURSO
  FINALIZADO
  VALIDADO
  CERRADO
  CANCELADO
}

enum TipoTarifa {
  PAGADO
  VOLUNTARIO
}

enum EstadoPagoProfesional {
  PENDIENTE
  PAGADO
}

// Clasificación operativa del servicio (sección "hay que clasificar bien
// los servicios para poder cotizarlos y ubicarlos y gestionarlos
// correctamente"): un encargo puntual (ej. "limpieza el viernes") frente a
// un contrato recurrente (ej. "acompañamiento todos los días de 9 a 13").
enum TipoServicio {
  PUNTUAL
  RECURRENTE
}

model Servicio {
  id           String         @id @default(cuid())
  codigo       String         @unique // SRV-000721
  estado       EstadoServicio @default(PENDIENTE)
  tipoServicio TipoServicio   @default(PUNTUAL)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  solicitudId String    @unique
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])

  profesionalId String?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])

  // Subcontratación opcional a una empresa colaboradora, alternativa o
  // adicional a la asignación de un profesional interno.
  empresaColaboradoraId String?
  empresaColaboradora   EmpresaColaboradora? @relation(fields: [empresaColaboradoraId], references: [id])

  // Información económica: solo visible para gestores de la organización y
  // para el familiar autorizado con permiso explícito (sección 4/14 —
  // minimización). La persona atendida nunca la recibe.
  //
  // CUIDA cobra por tiempo, así que el precio se fija por hora y el importe
  // sale de las horas acordadas: 2 h a 13 €/h son 26 €. Antes tarifaImporte
  // era un total a ojo y no se podía comprobar contra lo fichado.
  precioHora Decimal? @db.Decimal(10, 2)
  // Duración acordada de una jornada, en minutos. Sale del plan (de la hora
  // de inicio a la de fin) pero se congela aquí: es contra esto contra lo
  // que se compara lo fichado al verificar.
  minutosPrevistos Int?
  // % de CUIDA para este servicio. Se copia del de la organización al fijar
  // la tarifa y queda congelado, para que cambiar el % general no reescriba
  // servicios ya acordados.
  comisionPorcentaje Decimal? @db.Decimal(5, 2)

  // Importe de una jornada al precio y la duración de arriba. Se recalcula
  // solo cuando se cambian esos dos; el resto del sistema (facturación,
  // glosario de pagos) sigue leyendo de aquí.
  tarifaImporte Decimal?    @db.Decimal(10, 2)
  tarifaTipo    TipoTarifa?
  tarifaNotas   String?

  // IVA heredado de la necesidad/servicio del catálogo elegido en la
  // solicitud (sección "aplicar el 4% o el 10% de IVA"): igual que
  // comisionImporte, se calcula al fijar la tarifa y queda congelado en el
  // servicio aunque el % del catálogo cambie después.
  ivaPorcentaje Decimal? @db.Decimal(5, 2)
  ivaImporte    Decimal? @db.Decimal(10, 2)
  totalConIva   Decimal? @db.Decimal(10, 2)

  // Compensación al profesional/empresa que presta el servicio — distinta
  // de la tarifa cobrada a la familia. Solo aplica si tarifaTipo = PAGADO.
  pagoProfesionalEstado EstadoPagoProfesional @default(PENDIENTE)

  // Comisión de gestión de CUIDA (sección "cobrar por gestión un pequeño
  // porcentaje"): se calcula al fijar la tarifa, a partir del % de la
  // organización. importeProfesional = tarifaImporte - comisionImporte es lo
  // que se liquida al profesional/empresa; comisionImporte es el margen de
  // CUIDA. Ambos quedan congelados en el servicio aunque cambie luego el %
  // de la organización, para no alterar liquidaciones ya calculadas.
  comisionImporte    Decimal? @db.Decimal(10, 2)
  importeProfesional Decimal? @db.Decimal(10, 2)

  // Servicio facturado: se enlaza a la factura mensual de la persona cuando
  // se genera (sección "cuenta mensual... al final de mes se le cobrará").
  facturaId String?
  factura   Factura? @relation(fields: [facturaId], references: [id])

  visitas         Visita[]
  incidencias     Incidencia[]
  estadoHistorial EstadoHistorial[]
  documentos      Documento[]
  interesados     ServicioInteres[]

  @@map("servicios")
}

// Candidatura de un profesional a un servicio publicado sin asignar todavía
// (sección "sale en la búsqueda para ser aceptado por los profesionales...
// a Carmen le sale una nueva publicación... ella acepta"): coordinación ve
// la lista de interesados y elige, en vez de depender de una notificación
// suelta sin registro consultable.
model ServicioInteres {
  id        String   @id @default(cuid())
  mensaje   String?
  createdAt DateTime @default(now())

  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id])

  @@unique([servicioId, profesionalId])
  @@map("servicio_interesados")
}

enum EstadoFactura {
  BORRADOR
  EMITIDA
  PAGADA
}

// Facturación mensual a la familia (sección "función es cobrar por gestión
// un pequeño porcentaje... al final de mes se le cobrará el importe"):
// agrupa los servicios PAGADO de una persona en un mes natural, calcula el
// total cobrado, la comisión retenida y el neto a liquidar a profesionales.
model Factura {
  id                   String        @id @default(cuid())
  codigo               String        @unique // FAC-000012
  mes                  String // "2026-09"
  // importeTotal es la base imponible (suma de tarifas sin IVA); ivaTotal y
  // totalConIva se añaden aparte para poder emitir una factura con IVA
  // desglosado (sección "aplicar el 4% o el 10% de IVA").
  importeTotal         Decimal       @db.Decimal(10, 2)
  ivaTotal             Decimal       @default(0) @db.Decimal(10, 2)
  totalConIva          Decimal       @default(0) @db.Decimal(10, 2)
  comisionTotal        Decimal       @db.Decimal(10, 2)
  importeProfesionales Decimal       @db.Decimal(10, 2)
  estado               EstadoFactura @default(BORRADOR)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id])

  servicios Servicio[]
  visitas   Visita[]

  @@unique([personaId, mes])
  @@map("facturas")
}

// Chat entre la persona/familia y un profesional (sección "el panel de
// chat debe ser más intuitivo, no una caja por cada servicio... si es el
// mismo profesional se debe poder visualizar todo junto"): la conversación
// se ancla al par (persona, profesional), no a un servicio concreto — así
// un profesional con varios servicios para la misma familia tiene un único
// hilo, no uno repetido por cada uno.
model Mensaje {
  id        String   @id @default(cuid())
  texto     String
  createdAt DateTime @default(now())

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id])

  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id])

  autorUsuarioId String
  autor          Usuario @relation(fields: [autorUsuarioId], references: [id])

  @@map("mensajes")
}

enum EstadoVisita {
  PROGRAMADA
  CONFIRMADA
  EN_CURSO
  FINALIZADA
  INCIDENCIA
  REVISADA
}

model Visita {
  id             String       @id @default(cuid())
  codigo         String       @unique // VIS-001923
  fecha          DateTime
  horaInicioProg String?
  horaFinProg    String?
  horaInicioReal DateTime?
  horaFinReal    DateTime?
  estado         EstadoVisita @default(PROGRAMADA)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  // Snapshot del profesional que hizo la visita (sección "poder cambiar de
  // profesional si este se enferma... y que esto se tenga en cuenta en su
  // facturación"): se copia de servicio.profesionalId al crear la visita, y
  // ya no cambia aunque el servicio se reasigne después — así el historial
  // de horas por profesional no se corrompe con una reasignación posterior.
  profesionalId String?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])

  // Facturación por horas de servicios recurrentes (sección "las que son
  // recurrentes... se facturan"): un servicio RECURRENTE nunca se cierra,
  // así que se factura por periodo a partir de las horas reales de sus
  // visitas de ese mes, no a partir del propio Servicio como en PUNTUAL.
  facturaId String?
  factura   Factura? @relation(fields: [facturaId], references: [id])

  tareas          Tarea[]
  actuaciones     Actuacion[]
  incidencias     Incidencia[]
  documentos      Documento[]
  estadoHistorial EstadoHistorial[]

  @@map("visitas")
}

model Tarea {
  id          String   @id @default(cuid())
  visitaId    String
  visita      Visita   @relation(fields: [visitaId], references: [id])
  descripcion String
  completada  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("tareas")
}

// "Lo ocurrido": observación registrada durante o al cierre de la visita.
// Nunca sustituye una historia clínica ni un diagnóstico (sección 14).
model Actuacion {
  id          String   @id @default(cuid())
  visitaId    String
  visita      Visita   @relation(fields: [visitaId], references: [id])
  descripcion String
  createdAt   DateTime @default(now())

  @@map("actuaciones")
}

enum EstadoIncidencia {
  NUEVA
  EN_REVISION
  ASIGNADA
  EN_RESOLUCION
  RESUELTA
  CERRADA
}

enum PrioridadIncidencia {
  BAJA
  MEDIA
  ALTA
}

enum TipoIncidencia {
  GENERAL
  SOLICITUD_CANCELACION
}

enum MotivoIncidencia {
  SALUD // caída, malestar, un susto
  ACCESO // no se puede entrar: llaves, portal, nadie abre
  AUSENCIA // el profesional o la persona no estaban
  RETRASO
  TRATO // desacuerdo o queja sobre el trato
  MATERIAL // falta material o algo está estropeado
  HORARIO // cambio o confusión de horario
  // Las horas fichadas no cuadran con lo acordado: se ha trabajado de más,
  // de menos, o coordinación quiere confirmarlo antes de verificar. Es el
  // camino cuando no cuadra un fichaje, porque el fichaje no se reescribe.
  HORAS
  OTRO
}

model Incidencia {
  id     String         @id @default(cuid())
  codigo String         @unique // INC-000045
  tipo   TipoIncidencia @default(GENERAL)
  // Motivo: de qué va la incidencia, en una palabra. Es lo que permite
  // agrupar y filtrar ("¿cuántas caídas llevamos este mes?"); la descripción
  // cuenta el caso concreto y no se puede agrupar por ella.
  motivo      MotivoIncidencia @default(OTRO)
  descripcion String
  prioridad   PrioridadIncidencia @default(MEDIA)
  estado      EstadoIncidencia    @default(NUEVA)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  visitaId String?
  visita   Visita? @relation(fields: [visitaId], references: [id])

  servicioId String?
  servicio   Servicio? @relation(fields: [servicioId], references: [id])

  responsableUsuarioId String?
  responsable          Usuario? @relation("IncidenciaResponsable", fields: [responsableUsuarioId], references: [id])

  // Quién la abrió. Sin esto, en la ficha ponía el caso pero no de quién
  // venía el aviso, y coordinación no sabía a quién llamar para
  // preguntar. Opcional porque las incidencias anteriores no lo guardaban.
  creadoPorUsuarioId String?
  creadoPor          Usuario? @relation("IncidenciaCreadaPor", fields: [creadoPorUsuarioId], references: [id])

  estadoHistorial EstadoHistorial[]

  @@map("incidencias")
}

// ---------------------------------------------------------------------------
// Documentos, notificaciones, historial de estados y auditoría
// ---------------------------------------------------------------------------

model Documento {
  id        String   @id @default(cuid())
  nombre    String
  url       String
  createdAt DateTime @default(now())

  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id])

  servicioId String?
  servicio   Servicio? @relation(fields: [servicioId], references: [id])

  visitaId String?
  visita   Visita? @relation(fields: [visitaId], references: [id])

  // Documentos del propio profesional (sección "ver toda su información,
  // documentación... un perfil completamente avanzado"): DNI, certificados,
  // etc. — no atados a un servicio ni a una persona atendida.
  profesionalId String?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])

  @@map("documentos")
}

model Notificacion {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tipo      String
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  // Referencia a la ficha que debe abrir el frontend al pinchar la
  // notificación (normalmente una Solicitud — la vista unificada).
  entidadTipo String?
  entidadId   String?

  @@map("notificaciones")
}

// Historial de solo-inserción de cambios de estado. Cada transición registra
// quién, cuándo, estado anterior, nuevo estado y motivo (sección 8).
model EstadoHistorial {
  id             String   @id @default(cuid())
  entidadTipo    String // "Solicitud" | "Servicio" | "Visita" | "Incidencia"...
  estadoAnterior String?
  estadoNuevo    String
  motivo         String?
  createdAt      DateTime @default(now())

  solicitudId  String?
  solicitud    Solicitud?  @relation(fields: [solicitudId], references: [id])
  servicioId   String?
  servicio     Servicio?   @relation(fields: [servicioId], references: [id])
  visitaId     String?
  visita       Visita?     @relation(fields: [visitaId], references: [id])
  incidenciaId String?
  incidencia   Incidencia? @relation(fields: [incidenciaId], references: [id])

  @@map("estado_historial")
}

// Auditoría: quién / cuándo / qué acción, nunca modificable ni borrable
// desde la aplicación (append-only).
model AuditLog {
  id          String   @id @default(cuid())
  accion      String // "login", "ver_persona", "crear_solicitud", "cambiar_estado"...
  entidadTipo String?
  entidadId   String?
  detalle     String?
  createdAt   DateTime @default(now())

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  organizacionId String?
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])

  @@map("audit_logs")
}
